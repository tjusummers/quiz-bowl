# Copy to .env.local for local development. Leave empty to run without accounts.
# Both values are on Supabase: Project Settings -> API. The anon key is meant to be public.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional. Usernames become <username>@<this domain> inside Supabase; no email is ever sent.
VITE_ACCOUNT_EMAIL_DOMAIN=
